{
  "name": "ramble-on-mcp",
  "version": "1.5.0",
  "private": true,
  "description": "Ramble On MCP server: stdio for local use, Streamable HTTP for local or hosted use.",
  "scripts": {
    "mcp:stdio": "node mcp/bin/stdio.cjs",
    "mcp:http": "node mcp/bin/http.cjs",
    "start:hosted": "RAMBLE_HOSTED=1 node mcp/bin/http.cjs",
    "test:oauth": "node test/oauth-flow.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@google/genai": "^1.0.0",
    "zod": "^3.23.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
