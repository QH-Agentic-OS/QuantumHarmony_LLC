{
  "mcpServers": {
    "ramble-on": {
      "type": "http",
      "url": "https://ramble-on-mcp.onrender.com/mcp",
      "headers": {
        "X-Notion-Api-Key": "${user_config.notion_api_key}",
        "X-Ramble-Notion-Root": "${user_config.notion_root_page}",
        "X-Gemini-Api-Key": "${user_config.gemini_api_key}",
        "X-Anthropic-Api-Key": "${user_config.anthropic_api_key}",
        "X-OpenAI-Api-Key": "${user_config.openai_api_key}",
        "X-AI-Provider": "${user_config.ai_provider}"
      }
    }
  }
}
